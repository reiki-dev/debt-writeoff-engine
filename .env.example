# ==============================================================================
# Debt Portfolio Engine — Environment Configuration
# ==============================================================================

# Server Settings
PORT=3000
NODE_ENV=development

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string
JWT_EXPIRES=8h

# Core CRM API Integration (Export & Write-off endpoints)
API_KEY=your_crm_api_key_here
API_BASE_URL=https://api.example.test/api/v1.0/export/export

# Loan sold / assigned to collections detection keywords (comma-separated)
SOLD_STATUS_KEYWORDS=prodán,prodáno,prodana,sold,postoupeno,postoupená

# Demo & Mock Mode (disabled unless explicitly enabled)
# Set to true, 1, or yes to run offline with synthetic loan fixtures
MOCK_MODE=false

# Write-off Module Overrides (Optional)
CRM_EXPORT_ID=103
CRM_LOANS_EXPORT_ID=101
CRM_PAYMENTS_EXPORT_ID=102
CRM_AUTH_MODE=header
CRM_WRITEOFF_TRANSPORT=body
CRM_AUDIT_DIR=./audit
CRM_IDEMPOTENCY_GUARD=false
CRM_DEBT_TOLERANCE=0
# Pipeline settings
CRM_ADMIN_PATH=/admin
CRM_SCHEDULE_FORM_PATH=/admin/refund-schedule/create
SHEETS_NOTES_TAB=Notes
# example category IDs and reason IDs: 1, 2, 3, 4, 5
CRM_PIPELINE_CUSTOMER_CATEGORY=1
CRM_PIPELINE_CREDIT_CATEGORY=2
