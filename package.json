{
  "name": "debt-writeoff-engine",
  "version": "1.0.0",
  "description": "Debt write-off engine for consumer lending: integer-money waterfall, hard reconciliation guards, audit trail, RBAC web UI and CLI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:demo": "node scripts/start-demo.js",
    "dev": "nodemon server.js",
    "test": "node scripts/run-tests.js",
    "coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint:bom": "node scripts/check-bom.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run lint:bom && npm test",
    "add-user": "node scripts/add-user.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=18.18"
  },
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.1"
  }
}
