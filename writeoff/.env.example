# API key. Never hard-code it in the source.
CRM_API_KEY=

# Base URL. Production and test use the same host; test with a safe credit_id.
CRM_BASE_URL=https://api.example.test

# Export containing credit balances (l_*, r_*).
CRM_EXPORT_ID=103

# How to send the key: header (x-api-key, as specified) or query (?apiKey=).
CRM_AUTH_MODE=header

# How to send write-off parameters: body (JSON) or query.
# The specification table does not distinguish them; body is the configured default.
CRM_WRITEOFF_TRANSPORT=body

# Operator performing the operation; included in write-off notes and audit log.
CRM_ACTOR=

# Where to write the audit log (JSONL). Always written regardless of the flag below.
CRM_AUDIT_DIR=./audit

# Block repeated write-offs (already_applied / dangling_intent).
# Disabled: CRM itself rejects the same write-off being applied twice.
CRM_IDEMPOTENCY_GUARD=false

# Reconciliation tolerance for bucket sum vs debt, in haléře. 0 = block any difference.
CRM_DEBT_TOLERANCE=0

CRM_HTTP_TIMEOUT_MS=30000
